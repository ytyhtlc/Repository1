# --------------- 通用忽略规则 ---------------

# 操作系统生成的文件
.DS_Store
Thumbs.db
*.tmp
*.log

# IDE 和编辑器配置
.vscode/
.idea/
*.suo
*.iml

# --------------- 嵌入式/C语言专属 ---------------

# 编译生成的目录和文件
DebugConfig/
Listings/
Objects/
build/
dist/

# Keil MDK 用户专属配置（含个人电脑名的文件）
*.uvguix.*
project.uvoptx

# --------------- 其他语言/框架（备用） ---------------

# Python
__pycache__/
*.pyc
venv/

# 前端
node_modules/
